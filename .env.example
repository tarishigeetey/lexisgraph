# Copy to .env and adjust. .env is gitignored — never commit real values.

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=legal_clauses

# Embedding model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Ollama (local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Data — set this to where your CUAD lives, e.g.:
# CUAD_DIR=/mnt/c/workspace_tarishi/data/CUAD_v1
CUAD_DIR=data/cuad
